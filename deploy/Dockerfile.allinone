# syntax=docker/dockerfile:1
# All-in-one image: service + gateway + web (nginx + SPA) in ONE container on :8080, for a quick
# start that needs nothing but this image (SQLite at /data) or this image + Postgres.
# The split images (Dockerfile.service / .gateway / .web) remain the production shape.
# Build context = repo root. The three build stages mirror the split Dockerfiles step for step,
# so BuildKit shares their cache — keep them in step when those change.

# ---- Stage 1: service fat jar ----
FROM --platform=$BUILDPLATFORM eclipse-temurin:21-jdk AS service-build
WORKDIR /app
COPY service/gradlew service/gradlew.bat ./
COPY service/gradle ./gradle
COPY service/settings.gradle.kts service/build.gradle.kts ./
RUN ./gradlew --version --no-daemon >/dev/null 2>&1 || true
COPY service/src ./src
RUN ./gradlew fatJar --no-daemon && cp build/libs/claude-proxy-*-all.jar /app.jar

# ---- Stage 2: gateway binary (cross-compiled, no emulation) ----
FROM --platform=$BUILDPLATFORM golang:1.26-alpine AS gateway-build
ARG TARGETOS
ARG TARGETARCH
WORKDIR /app
COPY gateway/go.mod gateway/go.sum* ./
RUN go mod download 2>/dev/null || true
COPY gateway/ ./
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath -ldflags="-s -w" -o /gateway .

# ---- Stage 3: SPA ----
FROM --platform=$BUILDPLATFORM node:22-slim AS spa
WORKDIR /app/frontend
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate
COPY frontend/package.json frontend/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY frontend/ ./
RUN pnpm build            # → /app/frontend/dist

# ---- Runtime: JRE + nginx + the three artifacts ----
FROM eclipse-temurin:21-jre
ARG VERSION=dev
ARG REVISION=unknown
LABEL org.opencontainers.image.title="claude-proxy" \
      org.opencontainers.image.description="claude-proxy all-in-one: service + gateway + web UI in one container" \
      org.opencontainers.image.source="https://github.com/asyncdargen/claude-proxy" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${REVISION}"
# nginx: the router; gettext-base: envsubst for the shared template; tini: PID 1 (signals,
# zombie reaping); curl: the healthcheck.
RUN apt-get update \
    && apt-get install -y --no-install-recommends nginx gettext-base tini curl \
    && rm -rf /var/lib/apt/lists/* /etc/nginx/sites-enabled /etc/nginx/conf.d/* \
    && mkdir -p /data /etc/nginx/templates
COPY deploy/allinone/nginx.conf /etc/nginx/nginx.conf
COPY deploy/web/default.conf.template /etc/nginx/templates/default.conf.template
COPY deploy/web/proxy_common.conf deploy/web/proxy_stream.conf deploy/web/spa_gzip.conf /etc/nginx/
COPY --chmod=755 deploy/web/10-claude-proxy-upstreams.envsh /usr/local/lib/claude-proxy-upstreams.envsh
COPY --chmod=755 deploy/allinone/entrypoint.sh /usr/local/bin/claude-proxy-entrypoint
COPY --from=spa /app/frontend/dist /usr/share/nginx/html
COPY --from=gateway-build /gateway /usr/local/bin/gateway
COPY --from=service-build /app.jar /app/app.jar
WORKDIR /app
# Everything talks over loopback inside the container; only nginx's :8080 is meant to be published.
ENV SERVICE_UPSTREAM=127.0.0.1:8787 \
    GATEWAY_UPSTREAM=127.0.0.1:9000 \
    DB_PATH=/data/claude-proxy.db
EXPOSE 8080
VOLUME /data
HEALTHCHECK --interval=10s --timeout=3s --start-period=60s --retries=10 \
    CMD curl -fsS http://127.0.0.1:8080/healthz || exit 1
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/claude-proxy-entrypoint"]
