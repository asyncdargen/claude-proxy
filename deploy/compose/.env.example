# claude-proxy quick-start settings. Copy to .env next to the compose file and fill in — or run
# scripts/bootstrap.sh, which writes this file with random secrets for you.
# Every secret below: `openssl rand -hex 32` is fine.

# ---- Required ----
# Encrypts stored account credentials (AES-256-GCM). Losing it loses every stored account, and
# changing it invalidates them all — back it up separately from the database.
MASTER_KEY=
# Signs panel session cookies (defaults to MASTER_KEY when empty).
SESSION_SECRET=
# Bootstrap admin — created only while the users table is empty. Change the password after login.
ADMIN_USER=admin
ADMIN_PASSWORD=
# Postgres password. Fixed at the first start of the database volume; changing it later breaks
# authentication against the existing data.
DATABASE_PASSWORD=
# Shared secret of the private service↔gateway control API. Required by docker-compose.yml;
# optional for the all-in-one image (it generates one per start when empty).
INTERNAL_TOKEN=

# ---- Optional ----
# Public domain when served behind one (token base URL + CORS). Empty = the browser's origin.
# PUBLIC_DOMAIN=proxy.example.com
# Host address/port the web container is published on (default 127.0.0.1:8080).
# HTTP_BIND=127.0.0.1
# HTTP_PORT=8080
# Image tag: latest, or a release such as 0.2.0 to pin it.
# CLAUDE_PROXY_TAG=latest
# Dedicated HTTP CONNECT proxy for all server-side Anthropic traffic (no direct fallback).
# ANTHROPIC_PROXY_URL=http://user:password@proxy.example.com:3128
# Claude model for unmapped OpenAI model names on the routing gateway.
# DEFAULT_MODEL=claude-sonnet-5

# Everything else (OIDC, pricing sync, watchdogs, …) is documented in the repo's root
# .env.example; any of it can be added here.
