# syntax=docker/dockerfile:1
# Web image: the React SPA and the edge router in one nginx. Serves the static build at `/` and
# routes /api, /healthz, /gateway, /v1 and /routing/* to the service and the Go gateway
# (deploy/web/default.conf.template). Build context = repo root (needs frontend/ and deploy/web/).
#
# ---- Stage 1: build the SPA (static output, so it runs once on the build host's platform) ----
FROM --platform=$BUILDPLATFORM node:22-slim AS spa
WORKDIR /app/frontend
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate
COPY frontend/package.json frontend/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY frontend/ ./
RUN pnpm build            # → /app/frontend/dist

# ---- Stage 2: nginx serving the build + routing the rest ----
FROM nginx:1.27-alpine
ARG VERSION=dev
ARG REVISION=unknown
LABEL org.opencontainers.image.title="claude-proxy-web" \
      org.opencontainers.image.description="claude-proxy admin/chat UI and edge router (nginx)" \
      org.opencontainers.image.source="https://github.com/asyncdargen/claude-proxy" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${REVISION}"
# Rendered into /etc/nginx/conf.d/default.conf by the image's entrypoint; the filter keeps
# envsubst away from everything but our four variables.
ENV SERVICE_UPSTREAM=service:8787 \
    GATEWAY_UPSTREAM=gateway:9000 \
    RESOLVER=127.0.0.11 \
    NGINX_ENVSUBST_FILTER="^(SERVICE_UPSTREAM|GATEWAY_UPSTREAM|DATAPATH_UPSTREAM|RESOLVER)$"
RUN rm -f /etc/nginx/conf.d/default.conf
COPY deploy/web/default.conf.template /etc/nginx/templates/default.conf.template
COPY deploy/web/proxy_common.conf deploy/web/proxy_stream.conf deploy/web/spa_gzip.conf /etc/nginx/
COPY --chmod=755 deploy/web/10-claude-proxy-upstreams.envsh /docker-entrypoint.d/
COPY --from=spa /app/frontend/dist /usr/share/nginx/html
EXPOSE 8080
HEALTHCHECK --interval=10s --timeout=3s --retries=10 \
    CMD wget -q -O /dev/null http://127.0.0.1:8080/ || exit 1
