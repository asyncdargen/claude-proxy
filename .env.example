# ---- Required ----
# Secret used to encrypt account credentials at rest (AES-256-GCM). Use 32+ random chars.
MASTER_KEY=change-me-to-a-long-random-secret

# ---- Recommended ----
# Signs session cookies. Defaults to MASTER_KEY if unset.
SESSION_SECRET=change-me-too

# Bootstrap admin (created only when the DB has no users yet).
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# ---- Networking ----
# The Kotlin service binds here. In compose it's fronted by the nginx router (:8080) and
# reachable only as service:8787 on the compose network — the container pins BIND_HOST=0.0.0.0.
# Use 0.0.0.0 to expose on a server; 127.0.0.1 for local (service-only, no nginx) runs.
BIND_HOST=127.0.0.1
PORT=8787
# Public origin when deployed behind a domain (sets the token base URL + CORS for that origin).
# The datapath base URL clients use is <origin>/gateway (Claude Code appends /v1/...).
# PUBLIC_DOMAIN=proxy.example.com

# ---- Storage ----
# SQLite fallback, used when DATABASE_URL is unset (local runs).
DB_PATH=data/claude-proxy.db

# Postgres (production, and what docker-compose uses). docker-compose.yml sets DATABASE_URL/USER
# itself; it only needs DATABASE_PASSWORD from here — the same value the ./pgdata volume was
# initialized with. Changing it after first boot breaks auth against the existing volume.
DATABASE_PASSWORD=change-me
# DATABASE_URL=jdbc:postgresql://localhost:5432/claudeproxy
# DATABASE_USER=claudeproxy

# ---- Upstream ----
UPSTREAM_BASE_URL=https://api.anthropic.com

# Optional dedicated HTTP CONNECT proxy for ALL server-side Anthropic traffic: Go gateways,
# Kotlin fallback/chat, OAuth token exchange/refresh/profile and limit probes. Empty = direct.
# Optional percent-encoded username/password; keep this file private when credentials are set.
# No direct fallback, no HTTP_PROXY/HTTPS_PROXY/NO_PROXY inheritance. HTTP proxies only.
# ANTHROPIC_PROXY_URL=http://user:password@proxy.example.com:3128
ANTHROPIC_PROXY_URL=

# ---- Gateway (Spec B) ----
# Shared secret gating the private /internal/* control API. The service and the Go gateway must
# use the SAME value. Generate a long random secret (e.g. `openssl rand -hex 32`). nginx never
# routes /internal publicly. Leave unset to keep the control API disabled during rollout.
INTERNAL_TOKEN=change-me-to-a-long-random-secret

# How long an open stream may go without a content-bearing upstream frame before the relay ends it
# with a retryable error (0 disables the watchdog). Anthropic's pings don't count as progress. While
# a tool input is being buffered upstream the budget is 4× this — a 40 KB Write legitimately takes
# minutes of silence. Keep it under Claude Code's own patience (~600s on a gateway base URL).
UPSTREAM_STALL_SECONDS=120

# How long a streaming request may wait for Anthropic's response head before we open the client's
# stream ourselves and start sending keep-alives (0 disables it). Guards against whatever fronts the
# gateway timing the request out on that silence — Cloudflare cuts it off at ~100s with a 524.
EARLY_HEAD_SECONDS=45

# ---- API routing gateways (OpenAI/Anthropic emulation over Claude Code subscriptions) ----
# The gateway-openai / gateway-anthropic services expose the OpenAI + Anthropic API contracts and
# serve them through the account pool (source="routing", metered against a separate per-user daily
# limit + the ROUTING_USE permission). They share INTERNAL_TOKEN + UPSTREAM_BASE_URL with the
# datapath gateway. nginx fronts them at /routing/openai and /routing/anthropic.
# Claude model used for unmapped OpenAI model names (gateway-openai only):
# DEFAULT_MODEL=claude-sonnet-4-5
# Optional exact OpenAI->Claude overrides as JSON, e.g. {"gpt-4o":"claude-opus-4-8"}:
# OPENAI_MODEL_MAP=

# ---- OAuth (optional overrides; defaults are the public Claude Code values) ----
# OAUTH_CLIENT_ID=
# OAUTH_AUTHORIZE_URL=
# OAUTH_TOKEN_URL=
# OAUTH_REDIRECT_URI=
# OAUTH_SCOPES=
